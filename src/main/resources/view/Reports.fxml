<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ReportsController"
            prefWidth="900" prefHeight="650">

    <top>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Reports &amp; Analytics"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <Label text="Select Month:"/>
                <ComboBox fx:id="monthComboBox"
                          promptText="Choose Month"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <HBox spacing="30">
                <VBox spacing="8">
                    <Label text="Monthly Total"/>
                    <Label fx:id="totalLabel" text="0.00"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Average Expense"/>
                    <Label fx:id="averageLabel" text="0.00"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Highest Category"/>
                    <Label fx:id="highestCategoryLabel" text="N/A"/>
                </VBox>
            </HBox>

            <Label text="Expenses by Category"/>

            <PieChart fx:id="categoryPieChart"
                      prefHeight="250"/>

            <Label text="Category Comparison"/>

            <BarChart fx:id="categoryBarChart"
                      prefHeight="250">
                <xAxis>
                    <CategoryAxis/>
                </xAxis>
                <yAxis>
                    <NumberAxis/>
                </yAxis>
            </BarChart>

            <Label fx:id="statusLabel"
                   text="Select a month to view reports."/>

        </VBox>
    </center>

</BorderPane>

