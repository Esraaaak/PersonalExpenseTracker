<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.CategoryController"
      stylesheets="@/style.css"
      styleClass="section-card"
      spacing="12"
      prefWidth="520"
      prefHeight="420">

    <Label text="Categories"
           styleClass="section-title"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS" spacing="4">
            <Label text="Category name" styleClass="field-label"/>
            <TextField fx:id="nameField"
                       promptText="e.g. Food"
                       styleClass="app-text-field"
                       maxWidth="1.7976931348623157E308"/>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" spacing="4">
            <Label text="Description" styleClass="field-label"/>
            <TextField fx:id="descriptionField"
                       promptText="Optional description"
                       styleClass="app-text-field"
                       maxWidth="1.7976931348623157E308"/>
        </VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="addButton"
                text="Add"
                styleClass="primary-button"
                minWidth="90"/>

        <Button fx:id="updateButton"
                text="Update"
                styleClass="secondary-button"
                minWidth="90"/>

        <Button fx:id="deleteButton"
                text="Delete"
                styleClass="danger-button"
                minWidth="90"/>
    </HBox>

    <ListView fx:id="categoryListView"
              VBox.vgrow="ALWAYS"
              styleClass="app-list-view"/>

    <Label fx:id="statusLabel"
           text=""
           styleClass="status-label"/>
</VBox>
